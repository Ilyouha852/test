{
  "name": "support_bot_ist",
  "version": "1.0.0",
  "description": "Репозиторий для проекта Бот Поддержки",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node src/index.ts",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "setup": "node scripts/create-env.js",
    "db:start": "node scripts/start-db.cjs",
    "db:stop": "node scripts/stop-db.cjs",
    "db:status": "node scripts/db-status.cjs",
    "db:logs": "docker-compose logs dynamodb-local",
    "minio:start": "node scripts/start-minio.cjs",
    "minio:stop": "node scripts/stop-minio.cjs",
    "minio:status": "node scripts/minio-status.cjs",
    "minio:logs": "docker-compose logs minio",
    "deploy:swarm": "node scripts/deploy-to-swarm.js",
    "deploy:test": "node scripts/test-deploy.js",
    "docker:build": "docker build -t support-bot-ist .",
    "docker:run": "docker run -p 3007:3007 -e JWT_SECRET=test support-bot-ist",
    "docker:build-run": "npm run docker:build && npm run docker:run",
    "storage:start": "npm run db:start && npm run minio:start",
    "storage:stop": "npm run db:stop && npm run minio:stop",
    "storage:status": "npm run db:status && npm run minio:status",
    "dev:with-db": "npm run db:start && timeout 3 && npm run dev",
    "dev:with-storage": "npm run storage:start && timeout 5 && npm run dev",
    "dev:full": "npm run storage:start && timeout 5 && npm run dev",
    "db:check-connection": "node scripts/check-dynamo-connection.cjs",
    "system:check": "node scripts/check-system.cjs",
    "test:dynamodb": "npx ts-node src/test-dynamo-db.ts",
    "test-client": "npx ts-node src/test-client.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/client-s3": "^3.937.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@paralleldrive/cuid2": "^3.1.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "morgan": "^1.10.1",
    "node-cache": "^5.1.2",
    "xstate": "^5.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.9.1",
    "@types/supertest": "^6.0.3",
    "@vitest/eslint-plugin": "^1.3.24",
    "@xstate/cli": "^0.5.17",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-vitest": "^0.5.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeneZ0/Support_Bot_IST.git"
  },
  "keywords": [
    "bot",
    "support",
    "xstate",
    "express",
    "typescript",
    "dynamodb",
    "minio",
    "s3",
    "storage"
  ],
  "author": "ZeneZ0",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ZeneZ0/Support_Bot_IST/issues"
  },
